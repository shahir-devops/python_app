node{
 def version = env.BUILD_NUMBER
 def image = "shahir5890/pythonorder:v1.0.${version}"
 
 stage("checkout_git"){
     git credentialsId: 'git_user', url: 'https://github.com/shahir-devops/python_app.git'
 }
 stage("replace"){
     sh "sed -i 's/version/${version}/g' k8s/user_deployment.yml"
 }
 stage("docker_build"){
     sh "docker build -t ${image} user/"
 }
 stage("docker_push"){
     withCredentials([usernamePassword(credentialsId: 'docker_cred', passwordVariable: 'docker_pass', usernameVariable: 'docker_user')]) {
         sh "echo $docker_pass| docker login -u ${docker_user} --password-stdin"
         sh "docker push ${image}"
    }
 }
 stage("deploy"){
     sh "kubectl apply -f  k8s/user_deployment.yml"
 }
}
